{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musashi-dojo.dev/schemas/agent-memory.schema.json",
  "title": "Agent memory metadata",
  "type": "object",
  "required": ["schema_version", "agent", "repository", "local_workspace", "active_context"],
  "properties": {
    "schema_version": {"const": 1},
    "agent": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {"name": {"const": "Niten"}, "role": {"const": "Dojo Node Operator"}},
      "additionalProperties": true
    },
    "repository": {"type": "object", "additionalProperties": true},
    "local_workspace": {"type": "object", "additionalProperties": true},
    "active_context": {
      "type": "object",
      "required": ["host_id", "node_id", "changed_at"],
      "properties": {
        "host_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
        "node_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
        "changed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
