{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musashi-dojo.dev/schemas/connection-profile.schema.json",
  "title": "Connection profile",
  "type": "object",
  "required": ["schema_version", "host_id", "access", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "host_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
    "access": {
      "type": "object",
      "required": ["method", "user", "port", "authentication", "privilege_escalation"],
      "properties": {
        "method": {"type": ["string", "null"], "minLength": 1},
        "user": {"type": ["string", "null"], "minLength": 1},
        "port": {"type": ["integer", "null"], "minimum": 1, "maximum": 65535},
        "authentication": {"type": "string", "minLength": 1},
        "privilege_escalation": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": ["last_verified_at", "signals"],
      "properties": {
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "signals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
