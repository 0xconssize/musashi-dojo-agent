{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musashi-dojo.dev/schemas/inventory.schema.json",
  "title": "Host and node inventory",
  "type": "object",
  "required": ["schema_version", "hosts", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "hosts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "nodes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 63
    }
  },
  "additionalProperties": false
}
