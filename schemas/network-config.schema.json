{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musashi-dojo.dev/schemas/network-config.schema.json",
  "title": "Current Musashi network declaration",
  "type": "object",
  "required": ["schema_version", "network", "release", "configuration", "requirements", "warnings", "sources", "freshness"],
  "properties": {
    "schema_version": {"const": 1},
    "network": {
      "type": "object",
      "required": ["id", "name", "environment", "phase", "status", "network_magic", "network_id", "era", "consensus_mode"],
      "properties": {
        "id": {"const": "musashi"},
        "name": {"type": "string", "minLength": 1},
        "environment": {"const": "prototype-testnet"},
        "phase": {"type": "string", "minLength": 1},
        "status": {"enum": ["experimental", "paused", "retired", "unknown"]},
        "network_magic": {"type": "integer", "minimum": 0},
        "network_id": {"enum": ["Testnet", "unknown"]},
        "era": {"type": ["string", "null"], "minLength": 1},
        "consensus_mode": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["selected", "selection_basis", "node_version_reported", "published_at", "tag_commit", "newer_available_not_selected"],
      "properties": {
        "selected": {"type": "string", "pattern": "^prototype-[0-9]{4}w[0-9]+[a-z]?$"},
        "selection_basis": {"type": "string", "minLength": 1},
        "node_version_reported": {"type": ["string", "null"], "minLength": 1},
        "published_at": {"type": ["string", "null"], "format": "date-time"},
        "tag_commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "newer_available_not_selected": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": ["base_url", "pin_script", "pin_script_commit", "verified_at", "files", "chain"],
      "properties": {
        "base_url": {"type": "string", "format": "uri"},
        "pin_script": {"type": "string", "format": "uri"},
        "pin_script_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verified_at": {"type": "string", "format": "date-time"},
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "chain": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "required": ["file", "verified_at"],
      "properties": {
        "file": {"const": "requirements.yaml"},
        "verified_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "warnings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sources": {
      "type": "object",
      "required": ["authoritative_root", "linked_official", "supplementary"],
      "properties": {
        "authoritative_root": {"type": "object", "additionalProperties": true},
        "linked_official": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "supplementary": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["status", "verified_at", "review_before_use", "stale_when"],
      "properties": {
        "status": {"enum": ["current-as-reviewed", "stale", "obsolete", "unknown"]},
        "verified_at": {"type": "string", "format": "date-time"},
        "review_before_use": {"type": "boolean"},
        "stale_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
